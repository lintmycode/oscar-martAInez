# OpenAI API Key (required for invoice extraction)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Optional: Adjust budget limits in config.js

# Email intake (poll-inbox.js) - optional, see SETUP.md "Email Intake"
# From a Google Cloud OAuth client (type: Desktop app) with the Gmail API enabled
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# poll-inbox.js on echo (see SETUP.md "Running on echo")
# OSCAR_DATA_ROOT=/mnt/echo-ops/oscar
# CHROME_PATH=/home/nuno/.cache/puppeteer/chrome-headless-shell/linux-<version>/chrome-headless-shell-linux64/chrome-headless-shell
# TELEGRAM_CHAT_ID=   # nuno's DM; bot token is read from ~/.openclaw/openclaw.json

# Monthly close (see SETUP.md "Monthly close")
# Addresses allowed to send "sem fatura" waiver emails (comma-separated). Anyone can
# email the intake inbox, so waivers from any other sender are ignored.
OSCAR_OWNER_EMAILS=
# Where the finished bundle email is sent (U4)
OSCAR_REPORT_TO=
# Testing: OSCAR_DRY_RUN=1 prints Telegram/email instead of sending;
# OSCAR_TODAY=YYYY-MM-DD fakes today's date for close-month.js --due
